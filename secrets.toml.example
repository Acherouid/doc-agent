# Copy to .streamlit/secrets.toml for local runs (it is in .gitignore),
# and paste the same content in Streamlit Cloud: App -> Settings -> Secrets.

LLM_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai/"
LLM_API_KEY = "your-gemini-key"          # the key YOU pay for (used for invite codes only)
LLM_MODEL = "your-model-name"            # same value as in your .env
# BYOK_MODEL = "..."                     # optional: model used with visitors' own keys (defaults to LLM_MODEL)

SUPABASE_URL = "https://xxxx.supabase.co"
SUPABASE_SERVICE_KEY = "service-role-key"  # Settings -> API Keys -> service_role. Never expose it client-side.

DAILY_CAP = 40                           # max sponsored documents per day, all codes together

CONTACT_WHATSAPP = "212600000000"        # your number, international format, digits only (shows a WhatsApp link)
APP_URL = "https://your-app.streamlit.app"  # used by admin.py in the message you send
